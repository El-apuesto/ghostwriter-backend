# Database
DATABASE_URL=sqlite:///./ghostwriter.db

# LLM Configuration
LLM_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=your_groq_api_key_here

# Image Generation (xAI Grok for AI cover generation)
XAI_API_KEY=your_xai_api_key_here

# Model Selection (Groq models)
CREATIVE_MODEL=llama-3.3-70b-versatile
STRUCTURED_MODEL=llama-3.3-70b-versatile
DIALOGUE_MODEL=llama-3.3-70b-versatile
BIOGRAPHY_MODEL=llama-3.3-70b-versatile

# Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# App URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Generation Settings
MAX_TOKENS_PER_REQUEST=4000
TEMPERATURE=0.8
